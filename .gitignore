# Relay runtime state (per-machine, never committed)
.relay/
*.relay-backup.*

# Python
__pycache__/
*.pyc

# OS / editor noise
.DS_Store
*.swp

# Widget build artifacts (Rust/Tauri) - 1GB+, fully regenerable
widget/src-tauri/target/
widget/src-tauri/gen/

# Internal design/planning docs - kept locally, never published.
# The whole directory: specs, plans and drafts are working notes for this
# repo's own development, not documentation for anyone installing relay.
# NOTE: `git clean -fdx` deletes ignored files - docs/ included. Recovery is
# ~/Work/relay-notes/relay-pre-docs-purge-2026-08-22.bundle, which still
# carries the full pre-purge history of this directory.
docs/

# graphify knowledge-graph output (local, regenerable)
graphify-out/
.superpowers/
